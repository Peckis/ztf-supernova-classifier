# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#
# cron does not source ~/.profile, so the nightly job reads them from here.
# Get these from https://www.wis-tns.org -> your profile -> Bots.
TNS_BOT_ID=197983
TNS_BOT_NAME=TCD_SN_Stamp_Bot
TNS_API_KEY=put-your-key-here
